{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crucible-frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "8080", "--host", "127.0.0.1"],
      "cwd": "crucible/frontend",
      "port": 8080,
      "url": "http://127.0.0.1:8080"
    },
    {
      "name": "crucible-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "crucible.backend.app:app", "--host", "127.0.0.1", "--port", "8081"],
      "port": 8081,
      "url": "http://127.0.0.1:8081"
    }
  ]
}
